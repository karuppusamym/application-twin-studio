<Activity mc:Ignorable="sap sap2010" x:Class="PostHostMemo"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:ut="clr-namespace:UiPath.Terminal.Activities;assembly=UiPath.Terminal.Activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_HostConnection" Type="InArgument(x:String)" />
    <x:Property Name="in_HostUser" Type="InArgument(x:String)" />
    <x:Property Name="in_HostPassword" Type="InArgument(x:String)" />
    <x:Property Name="in_Account" Type="InArgument(x:String)" />
    <x:Property Name="in_MemoCode" Type="InArgument(x:String)" />
    <x:Property Name="out_Posted" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <Sequence DisplayName="Post QC memo on core banking host">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="hostMessage" />
    </Sequence.Variables>
    <ut:TerminalSession DisplayName="Core banking 3270 session" ConnectionString="[in_HostConnection]">
      <ut:TerminalSession.Body>
        <ActivityAction>
          <Sequence DisplayName="In host session">
            <ut:TerminalWaitScreenText DisplayName="Wait for sign on" Text="SIGN ON" />
            <ut:TerminalSetFieldAtPosition DisplayName="Userid" Row="10" Column="35" Text="[in_HostUser]" />
            <ut:TerminalSetFieldAtPosition DisplayName="Password" Row="12" Column="35" Text="[in_HostPassword]" />
            <ut:TerminalSendControlKey DisplayName="Enter" Key="Transmit" />
            <ut:TerminalWaitScreenText DisplayName="Wait for menu" Text="MAIN MENU" />
            <ut:TerminalSetFieldAtPosition DisplayName="Option 2" Row="20" Column="15" Text="2" />
            <ut:TerminalSendControlKey DisplayName="Enter" Key="Transmit" />
            <ut:TerminalWaitScreenText DisplayName="Wait for memo screen" Text="POST QC MEMO" />
            <ut:TerminalSetFieldAtPosition DisplayName="Account" Row="5" Column="25" Text="[in_Account]" />
            <ut:TerminalSetFieldAtPosition DisplayName="Memo code" Row="7" Column="25" Text="[in_MemoCode]" />
            <ut:TerminalSetFieldAtPosition DisplayName="Memo text" Row="9" Column="25" Text="QC REVIEW" />
            <ut:TerminalSendControlKey DisplayName="Enter" Key="Transmit" />
            <ut:TerminalGetTextAtPosition DisplayName="Read message line" Row="23" Column="2" Length="78" Text="[hostMessage]" />
            <Assign DisplayName="Posted?">
              <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Posted]</OutArgument></Assign.To>
              <Assign.Value><InArgument x:TypeArguments="x:Boolean">[hostMessage.Contains("POSTED")]</InArgument></Assign.Value>
            </Assign>
            <ut:TerminalSendControlKey DisplayName="PF3 back to menu" Key="F3" />
            <ut:TerminalSetFieldAtPosition DisplayName="Sign off" Row="20" Column="15" Text="X" />
            <ut:TerminalSendControlKey DisplayName="Enter" Key="Transmit" />
          </Sequence>
        </ActivityAction>
      </ut:TerminalSession.Body>
    </ut:TerminalSession>
  </Sequence>
</Activity>
